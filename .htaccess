# Hostinger (LiteSpeed): o singură versiune a site-ului — https, fără www (os/capabilities/seo/01-tehnic.md)
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://inchiriere-microbuze.ro/$1 [R=301,L]

# adresele de pagini fără slash final primesc slash (canonical-ul e cu slash)
DirectorySlash On

# Fișierele din assets/ au hash în nume → se pot ține în cache un an.
# Pagina HTML se revalidează mereu, ca vizitatorii să primească versiunea nouă imediat.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/foto/#">
    Header set Cache-Control "public, max-age=604800"
  </If>
</IfModule>
